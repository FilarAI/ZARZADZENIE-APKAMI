{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Biuro Filar",
  "version": "0.1.0",
  "identifier": "pl.filar.biuro",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Biuro Filar",
        "width": 1100,
        "height": 680,
        "minWidth": 960,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 24, "y": 28 },
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
